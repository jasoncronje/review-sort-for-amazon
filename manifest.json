{
  "manifest_version": 3,
  "name": "Review Sort for Amazon",
  "version": "1.7.2",
  "description": "Sort Amazon search results by review count, rating or a weighted score, across several result pages.",
  "icons": { "128": "icon.png", "48": "icon.png", "16": "icon.png" },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*",
        "*://*.amazon.co.uk/*", "*://*.amazon.ie/*", "*://*.amazon.de/*", "*://*.amazon.at/*",
        "*://*.amazon.fr/*", "*://*.amazon.be/*", "*://*.amazon.nl/*", "*://*.amazon.es/*",
        "*://*.amazon.it/*", "*://*.amazon.se/*", "*://*.amazon.pl/*", "*://*.amazon.com.tr/*",
        "*://*.amazon.ae/*", "*://*.amazon.sa/*", "*://*.amazon.eg/*", "*://*.amazon.in/*",
        "*://*.amazon.co.jp/*", "*://*.amazon.sg/*", "*://*.amazon.com.au/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
