{
  "manifest_version": 3,
  "name": "Review Sort for Amazon",
  "version": "2.1.0",
  "description": "Sort Amazon search results by most reviews, best rated or soonest delivery, and filter by arrival date, stars and ads.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.ie/*",
        "*://*.amazon.de/*",
        "*://*.amazon.at/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.be/*",
        "*://*.amazon.nl/*",
        "*://*.amazon.es/*",
        "*://*.amazon.it/*",
        "*://*.amazon.se/*",
        "*://*.amazon.pl/*",
        "*://*.amazon.com.tr/*",
        "*://*.amazon.ae/*",
        "*://*.amazon.sa/*",
        "*://*.amazon.eg/*",
        "*://*.amazon.in/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.sg/*",
        "*://*.amazon.com.au/*"
      ],
      "js": [
        "brands.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
